// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model user {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String?
  firstName        String
  lastName         String
  admin            Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  clinic           Clinic[]
  logs             logs[]
  userClinicGroups UserClinicGroup[]
  intakeForms      IntakeForm[]
}

model logs {
  id                String           @id @default(cuid())
  message           String?
  from              String?
  to                String?
  userId            String?
  clinicId          String?
  intakeFormId      String?
  user              user?            @relation(fields: [userId], references: [id])
  userClinicGroup   UserClinicGroup? @relation(fields: [userClinicGroupId], references: [id])
  userClinicGroupId String?
}

model Clinic {
  id          String            @id @default(cuid())
  name        String
  description String?
  members     UserClinicGroup[]
  user        user?             @relation(fields: [userId], references: [id])
  userId      String?
  intakeForms IntakeForm[]
}

model UserClinicGroup {
  id        String         @id @default(cuid())
  userId    String
  role      UserClinicRole @default(CLIENT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  active    Boolean        @default(true)
  user      user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      logs[]
  clinic    Clinic?        @relation(fields: [clinicId], references: [id])
  clinicId  String?
}

model IntakeForm {
  id         String         @id @default(cuid())
  clinicId   String
  userId     String
  status     ProgressStatus @default(NEW)
  clinicName String

  // Basic identifying information
  fullName           String
  businessName       String?
  primaryContactName String?
  preferredName      String?
  formerNames        String?
  birthDate          DateTime
  ssnEncrypted       String?
  pronouns           String?

  // Contact information
  mailingAddress         String
  physicalAddress        String
  phone                  String
  email                  String
  preferredContactMethod String
  safeContactTime        String
  language               String
  interpreterNeeded      String
  interpreterLanguage    String?
  safeVoicemail          String
  safeMessages           String

  // Financial and employment information
  monthlyIncome   String
  incomeSource    String
  employerName    String
  employerAddress String
  employerPhone   String

  // Attorney and referral information
  currentAttorney String
  referralSource  String
  referralOther   String?

  // Household and family information
  householdInfo          String
  maritalStatus          String?
  spouseName             String?
  spouseAddress          String?
  spouseBirthDate        DateTime?
  childrenNames          String?
  childrenBirthDates     String?
  householdMembers       String?
  householdRelationships String?
  othersInvolved         String?
  opposingParties        String?
  opposingPartyAttorney  String?

  // Legal matter information
  caseType               String
  reasonForIntake        String
  institutionsInvolved   String
  agencyName             String?
  agencyPersonDepartment String?
  agencyRelationship     String?
  agencyOtherIndividuals String?

  // Consent and signature
  consent   Boolean
  signature String

  // Relationships
  clinic Clinic @relation(fields: [clinicId], references: [id])
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProgressStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  WAITING_FOR_CLIENT_REVIEW
  CANCELLED
}

enum UserClinicRole {
  CLIENT
  PROVIDER
  ADMIN
}
